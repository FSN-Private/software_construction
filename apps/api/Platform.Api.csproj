<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.0.22" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <ProjectReference Include="../../packages/contracts/Platform.Contracts.csproj" />
    <ProjectReference Include="../../packages/storage/Platform.Storage.csproj" />
  </ItemGroup>
</Project>
