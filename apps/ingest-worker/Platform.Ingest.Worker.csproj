    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <ProjectReference Include="../../packages/storage/Platform.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../api/Database/Migrations/005_ingest_storage.sql" LogicalName="Platform.Ingest.Worker.Database.Migrations.005_ingest_storage.sql" />
    <EmbeddedResource Include="../api/Database/Migrations/005_ingest_workflows.sql" LogicalName="Platform.Ingest.Worker.Database.Migrations.005_ingest_workflows.sql" />
    <EmbeddedResource Include="../api/Database/Migrations/006_xmp_version_control.sql" LogicalName="Platform.Ingest.Worker.Database.Migrations.006_xmp_version_control.sql" />
  </ItemGroup>
</Project>
