    "test:accessibility": "node scripts/test-accessibility.mjs",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "prettier": "3.8.2",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
