<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../packages/contracts/Platform.Contracts.csproj" />
    <ProjectReference Include="../../packages/recovery/Platform.Recovery.csproj" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="[4.0.107]" />
    <PackageReference Include="AWSSDK.KeyManagementService" Version="[4.0.100.15]" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="[4.0.100.15]" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="[4.0.101.1]" />
    <PackageReference Include="AWSSDK.SQS" Version="[4.0.100.15]" />
  </ItemGroup>
</Project>
