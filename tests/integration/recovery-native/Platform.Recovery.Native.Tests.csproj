<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../apps/ingest-worker/DatabaseMigrator.cs" Link="DatabaseMigrator.cs" />
    <EmbeddedResource Include="../../../apps/api/Database/Migrations/*.sql" LogicalName="Platform.Ingest.Worker.Database.Migrations.%(Filename)%(Extension)" />
    <ProjectReference Include="../../../apps/recovery-worker/Platform.Recovery.Worker.csproj" />
  </ItemGroup>
</Project>
